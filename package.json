{
  "name": "cci-blog-admin",
  "private": true,
  "version": "1.1.0",
  "engines": {
    "node": ">=23.7.0",
    "npm": ">=11.7.0"
  },
  "scripts": {
    "build:admin:blocknote-css": "./node_modules/.bin/esbuild ./src/admin-v2/styles/blocknote.css --bundle --conditions=style --outfile=./tmp-cci-blog-blocknote.css --minify",
    "build:admin:tailwind": "node ./node_modules/tailwindcss/lib/cli.js -c tailwind.config.cjs -i ./src/admin-v2/styles/admin.css -o ./tmp-cci-blog-tailwind.css --minify",
    "build:admin:css": "npm run build:admin:blocknote-css && npm run build:admin:tailwind && node -e \"const fs=require('fs');fs.writeFileSync('./views/css/cci_blog_admin.css',fs.readFileSync('./tmp-cci-blog-blocknote.css','utf8')+'\\n'+fs.readFileSync('./tmp-cci-blog-tailwind.css','utf8'));fs.unlinkSync('./tmp-cci-blog-blocknote.css');fs.unlinkSync('./tmp-cci-blog-tailwind.css');\"",
    "build:admin:js": "node scripts/build-admin.mjs",
    "build:admin": "npm run build:admin:css && npm run build:admin:js",
    "package:presta": "node scripts/build-release.mjs",
    "format": "node scripts/quality/format.mjs",
    "format:check": "node scripts/quality/format.mjs --check"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@cci/admin-ui": "https://github.com/cool-cat-ideas/cci-admin-ui/releases/download/v1.0.1/cci-admin-ui-1.0.1.tgz",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/utils": "^6.0.22",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/pm": "^3.33.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@cci/admin-theme": "https://github.com/cool-cat-ideas/cci-admin-ui/releases/download/v1.0.1/cci-admin-theme-1.0.1.tgz",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19"
  }
}
